# HabitHero Environment Variables Template
# Copy this file to .env and supply actual values

# Backend Configuration (Phase 2)
PORT=5000
MONGODB_URI=mongodb://localhost:27017/habithero
JWT_SECRET=your_jwt_secret_key_here

# AI / LLM Configuration (Phase 3)
LLM_PROVIDER=gemini # or openai / anthropic
LLM_API_KEY=your_llm_api_key_here

# Fetch.ai uAgent Configuration (Phases 4-6)
AGENT_NAME=habithero_companion
AGENT_MAILBOX_KEY=your_agentverse_mailbox_key_here
AGENT_SEED_PHRASE=your_agent_recovery_seed_phrase_here
AGENT_PORT=8000
