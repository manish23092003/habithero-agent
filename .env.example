# HabitHero Environment Variables Template
# Copy this file to .env and supply actual values

# Backend Configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/habithero
JWT_SECRET=your_jwt_secret_key_here
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Transactional Email via Resend (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=HabitHero <recovery@yourdomain.com>

# AI Provider Selection ('groq' or 'gemini')
AI_PROVIDER=groq

# Groq AI Configuration (Primary — Free Tier: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini Configuration (Alternative / Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
ENABLE_GEMINI_FALLBACK=false

# Fetch.ai uAgent Configuration
AGENT_NAME=HabitHero
AGENT_MAILBOX_KEY=your_agentverse_mailbox_key_here
AGENT_SEED_PHRASE=your_agent_recovery_seed_phrase_here
AGENT_PORT=8000
AGENT_SERVICE_SECRET=your_agent_service_secret_here

# Internal Metrics & Observability Endpoint Security (/api/metrics)
METRICS_SECRET=your_secure_metrics_monitoring_secret_here

# Google OAuth 2.0 / Google Identity Services (Frontend & Backend)
# Web Client ID from Google Cloud Console (APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
